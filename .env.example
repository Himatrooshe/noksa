# Copy this file to .env.local for local development and fill in real values.
# Never commit .env.local or any file with real credentials.

# Set the canonical public origin before production deployment (no path).
# If omitted locally, sitemap/metadata use the incoming request origin.
SITE_URL=

# Neon Postgres connection string (neon.tech dashboard -> your project -> Connection string).
# Use the "pooled" connection string.
DATABASE_URL=

# A single shared login that unlocks /noksaboard (there are no separate
# per-user accounts). Choose your own values.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password

# Random secret used to sign the dashboard session cookie. Generate one with:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Product images: set in .env.local and your production hosting environment.
# All three values are server configuration; never expose the private key.
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_account
IMAGEKIT_PUBLIC_KEY=your_public_key
IMAGEKIT_PRIVATE_KEY=your_private_key

# Online checkout with Stripe (dashboard.stripe.com -> Developers -> API keys).
# Use test-mode keys (sk_test_...) until you are ready to take real payments.
# The webhook secret (whsec_...) comes from the webhook endpoint you add for
# https://YOUR-DOMAIN/api/stripe/webhook, or from `stripe listen` locally.
# See docs/CHECKOUT.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Sheets backup mirror (see docs/ADMIN_SETUP.md for how to create these)
GOOGLE_SERVICE_ACCOUNT_EMAIL=noksa-official@noksaofficial.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-key-here\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your-google-sheet-id

# Required for encrypted scheduled backups in this public repository.
# Generate a unique value with `openssl rand -hex 32` and keep a recovery copy
# in your password manager. Add the same value as a GitHub Actions secret.
BACKUP_ENCRYPTION_KEY=
