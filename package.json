{
  "name": "noksa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "build:production": "npm run db:migrate && npm run build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:check-catalog": "node scripts/check-catalog-migration.mjs",
    "backup:db": "node scripts/backup-db.mjs",
    "backup:sheets": "node scripts/backup-to-sheets.mjs",
    "backup:check": "node scripts/backup-to-sheets.mjs --check",
    "backup:encrypt": "node scripts/backup-archive.mjs",
    "backup:decrypt": "node scripts/backup-archive.mjs --decrypt",
    "backup": "npm run backup:db && npm run backup:encrypt && npm run backup:sheets"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@neondatabase/serverless": "^1.2.1",
    "gsap": "3.15.1",
    "next": "15.5.29",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "sanitize-html": "^2.18.2",
    "server-only": "^0.0.1",
    "stripe": "23.1.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.2",
    "dotenv": "^18.0.10",
    "googleapis": "^190.0.0",
    "typescript": "5.4.5"
  }
}
